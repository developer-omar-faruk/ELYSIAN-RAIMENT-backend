NODE_ENV=development
PORT=5000

# Comma-separated list of exact frontend origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (must be a replica set for transactions, Atlas is by default)
MONGODB_URI=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# One-time token typed into the admin "Create owner account" screen (min 24 chars)
INITIAL_ADMIN_SETUP_TOKEN=

# Cookies: lax works for localhost. Use "none" (with HTTPS) when frontend and API are on different sites.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# Set to 1 when running behind one reverse proxy (Render, Railway, Nginx, ...)
TRUST_PROXY=0

STORE_TZ=Asia/Dhaka
STORE_UTC_OFFSET=+06:00

LOGIN_MAX=10
LOG_LEVEL=info

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
OWNER_EMAIL=
FROM_EMAIL=